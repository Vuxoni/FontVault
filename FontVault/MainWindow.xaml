<Window
    x:Class="FontVault.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:FontVault.Converters">


    <Grid Padding="24">
        <Grid.Resources>
            <converters:BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="5">
            <TextBlock Text="FontVault" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Temporary font manager for Windows" Opacity="0.7"/>
        </StackPanel>

        <!-- Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,20,0,15">
            <Button Content="+ Load Font" Width="140" Click="LoadFont_Click"/>
            <CheckBox x:Name="PermanentInstallCheckBox" Content="Install permanently" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Font list -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind Fonts}" SelectionMode="None" IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Font information and preview -->
                            <StackPanel Grid.Column="0" Spacing="5">
                                <Grid>
                                    <TextBlock Text="The quick brown fox jumps over the lazy dog" FontFamily="{Binding PreviewFontFamily}" FontSize="25" FontWeight="Normal"
                                        TextTrimming="CharacterEllipsis" MaxLines="1" Visibility="{Binding PreviewAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <TextBlock Text="Couldn't load font preview" FontSize="18" FontStyle="Italic" Opacity="0.55"
                                        Visibility="{Binding PreviewAvailable, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding FamilyName}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding FilePath}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            </StackPanel>

                            <!-- Status -->
                            <Border Grid.Column="1" Padding="10,5" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.8"/>
                            </Border>

                            <!-- Unload button -->
                            <Button Grid.Column="2" Content="Unload" Tag="{Binding}" Click="UnloadFont_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" MinWidth="85"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,15,0,0">
            <Button Content="Unload All Fonts" Width="160" Click="UnloadAllFonts_Click"/>
        </StackPanel>
    </Grid>
</Window>